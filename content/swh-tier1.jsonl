{"id":"swh-t1-0004","lang":"swh","tier":1,"slot":"count.nine","domain":2,"text_native":"Tisa","text_romanized":null,"text_english":"Nine.","source_caption":"Nine.","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Swahili phrasebook","url":"https://en.wikivoyage.org/wiki/Swahili","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"swh-t1-0005","lang":"swh","tier":1,"slot":"count.one","domain":2,"text_native":"Moja","text_romanized":null,"text_english":"One.","source_caption":"One.","register":"neutral","direction":"say","why":"Counting from one upward in order, because a traveller counts by reciting rather than by arithmetic.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Swahili phrasebook","url":"https://en.wikivoyage.org/wiki/Swahili","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
