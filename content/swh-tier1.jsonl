{"id":"swh-t1-0008","lang":"swh","tier":1,"slot":"count.ten","domain":2,"text_native":"Kumi","text_romanized":null,"text_english":"Ten.","source_caption":"Ten.","register":"neutral","direction":"say","why":"The first number past the counting pattern in most of these languages.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Swahili phrasebook","url":"https://en.wikivoyage.org/wiki/Swahili","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
