{"id":"srp-t1-0001","lang":"srp","tier":1,"slot":"count.eight","domain":2,"text_native":"осам, osam","text_romanized":"OH-sahm","text_english":"Eight.","source_caption":"8","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0002","lang":"srp","tier":1,"slot":"count.five","domain":2,"text_native":"пет, pet","text_romanized":"peht","text_english":"Five.","source_caption":"5","register":"neutral","direction":"say","why":"Five is where most of these languages change to a different counting pattern, and knowing that in advance is the point of learning them in order.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0003","lang":"srp","tier":1,"slot":"count.four","domain":2,"text_native":"четири, četiri","text_romanized":"CHEH-tee-ree","text_english":"Four.","source_caption":"4","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0004","lang":"srp","tier":1,"slot":"count.nine","domain":2,"text_native":"девет, devet","text_romanized":"DEH-veht","text_english":"Nine.","source_caption":"9","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0005","lang":"srp","tier":1,"slot":"count.one","domain":2,"text_native":"један, jedan","text_romanized":"YEH-dahn","text_english":"One.","source_caption":"1","register":"neutral","direction":"say","why":"Counting from one upward in order, because a traveller counts by reciting rather than by arithmetic.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0006","lang":"srp","tier":1,"slot":"count.seven","domain":2,"text_native":"седам, sedam","text_romanized":"SEH-dahm","text_english":"Seven.","source_caption":"7","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0007","lang":"srp","tier":1,"slot":"count.six","domain":2,"text_native":"шест, šest","text_romanized":"shehst","text_english":"Six.","source_caption":"6","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0008","lang":"srp","tier":1,"slot":"count.ten","domain":2,"text_native":"десет, deset","text_romanized":"DEH-seht","text_english":"Ten.","source_caption":"10","register":"neutral","direction":"say","why":"The first number past the counting pattern in most of these languages.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0009","lang":"srp","tier":1,"slot":"count.three","domain":2,"text_native":"три, tri","text_romanized":"tree","text_english":"Three.","source_caption":"3","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0010","lang":"srp","tier":1,"slot":"count.two","domain":2,"text_native":"два, dva","text_romanized":"dvah","text_english":"Two.","source_caption":"2","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0011","lang":"srp","tier":1,"slot":"count.zero","domain":2,"text_native":"нула, nula","text_romanized":"NOO-lah","text_english":"None, zero.","source_caption":"0","register":"neutral","direction":"say","why":"Zero is the answer that gets misheard most often, because the word for nothing and the word for a small quantity are often unrelated.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0012","lang":"srp","tier":1,"slot":"price.bill","domain":3,"text_native":"Рачун, Молим. Račun, molim.","text_romanized":"RAH-choon, MOH-leem","text_english":"The bill, please.","source_caption":"The check, please.","register":"neutral","direction":"say","why":"Where the word for bill and the word for receipt are the same word and neither is 'account'.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0013","lang":"srp","tier":1,"slot":"price.card-ok","domain":3,"text_native":"Примате ли кредитне картице? Primate li kreditne kartice?","text_romanized":"PREE-mah-teh lee KREH-deet-neh KAHR-tee-tseh?","text_english":"Is card payment accepted?","source_caption":"Do you accept credit cards?","register":"neutral","direction":"say","why":"The alternative to carrying cash, and the question that decides whether you are standing in a queue that moves.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0014","lang":"srp","tier":1,"slot":"price.how-much","domain":3,"text_native":"Колико ово кошта? Koliko ovo košta?","text_romanized":"koh-LEE-koh OH-voh KOHSH-tah?","text_english":"How much is this?","source_caption":"How much is this?","register":"neutral","direction":"say","why":"The most useful question in the tier, and the one people are most afraid to ask. It is not rude anywhere.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0015","lang":"srp","tier":1,"slot":"price.too-cheap","domain":3,"text_native":"јефтино jeftino","text_romanized":"YEHF-tee-noh","text_english":"It is cheaper in my country.","source_caption":"cheap","register":"neutral","direction":"say","why":"Read as an accusation almost everywhere. Included because knowing that it is an accusation is worth more than being able to say it politely.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0016","lang":"srp","tier":1,"slot":"price.too-expensive","domain":3,"text_native":"Сувише је скупо. Suviše je skupo.","text_romanized":"SOO-vee-sheh yeh SKOO-poh","text_english":"That is too expensive.","source_caption":"That's too expensive.","register":"neutral","direction":"say","why":"Used with the hand gesture that accompanies it. The gesture carries the meaning and the word confirms it.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0017","lang":"srp","tier":1,"slot":"money.atm","domain":3,"text_native":"Где је банкомат? Gde je bankomat?","text_romanized":"gdeh yeh bahn-KOH-maht?","text_english":"Where is an ATM?","source_caption":"Where is an automatic teller machine (ATM)?","register":"neutral","direction":"understand","why":"Recognising rather than producing it: you will be shown the sign rather than expected to ask.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0018","lang":"srp","tier":1,"slot":"money.change","domain":3,"text_native":"Можете ли променити новац за мене? Možete li promeniti novac za mene?","text_romanized":"MOH-zheh-teh lee proh-MEH-nee-tee NOH-vahts zah MEH-neh?","text_english":"Please change this into local money.","source_caption":"Can you change money for me?","register":"neutral","direction":"say","why":"The word 'change' means both coins and alteration in several of these languages, and the wrong one is confusing.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0019","lang":"srp","tier":1,"slot":"money.exchange-rate","domain":3,"text_native":"Колики је курс? Koliki je kurs?","text_romanized":"koh-LEE-kee yeh koors?","text_english":"What is the exchange rate?","source_caption":"What is the exchange rate?","register":"neutral","direction":"understand","why":"Often answered by pointing at a board rather than spoken.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0020","lang":"srp","tier":1,"slot":"toilet.where","domain":12,"text_native":"тоалет toalet","text_romanized":"TWAH-leht","text_english":"Where is the toilet?","source_caption":"TOILET","register":"neutral","direction":"say","why":"The most urgent question in this tier and the one every phrasebook leads with. In several languages the word is the only one a traveller needs for years.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0021","lang":"srp","tier":1,"slot":"food.menu","domain":4,"text_native":"Могу ли добити јеловник? Mogu li dobiti jelovnik?","text_romanized":"MOH-goo lee DOH-bee-tee YEH-lohv-neek?","text_english":"The menu, please.","source_caption":"Can I look at the menu, please?","register":"neutral","direction":"say","why":"One question covers a whole meal. Most phrasebooks waste slots on individual dishes instead.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0022","lang":"srp","tier":1,"slot":"food.no-meat","domain":4,"text_native":"Не једем свињетину. Ne jedem svinjetinu.","text_romanized":"neh YEH-dehm SVEE-nyeh-tee-noo","text_english":"I do not eat meat.","source_caption":"I don't eat pork.","register":"neutral","direction":"say","why":"Saying it once at the start of the trip saves a refusal at the table, where it is awkward for both sides.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0023","lang":"srp","tier":1,"slot":"food.water","domain":4,"text_native":"воде vode","text_romanized":"VOH-deh","text_english":"Water, please.","source_caption":"water","register":"neutral","direction":"say","why":"Refusing the water in a restaurant is a small discourtesy in several of these countries. This is how to ask for some instead.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0024","lang":"srp","tier":1,"slot":"way.straight","domain":7,"text_native":"право pravo","text_romanized":"PRAH-voh","text_english":"Go straight ahead.","source_caption":"straight ahead","register":"neutral","direction":"understand","why":"Recognised rather than produced.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0025","lang":"srp","tier":1,"slot":"way.turn-left","domain":7,"text_native":"Скрените лево. Skrenite levo.","text_romanized":"SKREH-nee-teh LEH-voh","text_english":"Turn left.","source_caption":"Turn left.","register":"neutral","direction":"understand","why":"Recognised rather than produced: you are the one being given directions far more often than giving them.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0026","lang":"srp","tier":1,"slot":"way.turn-right","domain":7,"text_native":"Скрените десно. Skrenite desno.","text_romanized":"SKREH-nee-teh DEHS-noh","text_english":"Turn right.","source_caption":"Turn right.","register":"neutral","direction":"understand","why":"Recognised rather than produced.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0027","lang":"srp","tier":1,"slot":"stay.checkout","domain":5,"text_native":"Желим да се одјавим. Želim da se odjavim.","text_romanized":"ZHEH-leem dah seh OH-dyah-veem","text_english":"I would like to check out, please.","source_caption":"I want to check out.","register":"neutral","direction":"say","why":"Said the morning before leaving, so the bill is not waiting at the desk while luggage is being gathered.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0028","lang":"srp","tier":1,"slot":"move.destination","domain":6,"text_native":"Возите ме тамо, молим. Vozite me tamo, molim.","text_romanized":"VOH-zee-teh meh TAH-moh, MOH-leem","text_english":"Please take me there.","source_caption":"Take me there, please.","register":"neutral","direction":"say","why":"Shown with a map or a written address while saying it. 'There' is the word the pages use; 'this address' is in none of them, and a slot phrased from imagination rather than from a caption is a slot that can never be filled.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0029","lang":"srp","tier":1,"slot":"health.doctor","domain":9,"text_native":"Треба ми доктор. Treba mi doktor.","text_romanized":"TREH-bah mee DOHK-tohr","text_english":"I need a doctor.","source_caption":"I need a doctor.","register":"neutral","direction":"say","why":"Short enough to say to anyone, which is the point — a phrase you cannot finish is a phrase that arrives too late.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0030","lang":"srp","tier":1,"slot":"health.hurt","domain":9,"text_native":"Повређен сам (m). Повређена сам (f). Povređen sam (m). Povređena sam (f).","text_romanized":"POHV-reh-jehn sahm/POHV-reh-jeh-nah sahm","text_english":"I have been injured.","source_caption":"I've been injured.","register":"neutral","direction":"say","why":"Declares the situation before being asked. Several of these languages change tense or register on the word for injury, and the flat version sounds like a complaint.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0031","lang":"srp","tier":1,"slot":"help.dont-touch","domain":10,"text_native":"Не дирај ме! Ne diraj me!","text_romanized":"NEH dee-rai meh","text_english":"Do not touch me.","source_caption":"Don't touch me!","register":"neutral","direction":"say","why":"Out loud and to a person, not shouted generally. Several of these languages treat it as an accusation, so it is a sentence to use deliberately.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0032","lang":"srp","tier":1,"slot":"help.emergency","domain":10,"text_native":"Хитно је. Hitno je.","text_romanized":"HIT-noh yeh","text_english":"It is an emergency.","source_caption":"It's an emergency.","register":"neutral","direction":"say","why":"Changes how the next thirty seconds go. Two words, and in several of these languages it reaches a different set of responses than a request would.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0033","lang":"srp","tier":1,"slot":"help.leave-me-alone","domain":10,"text_native":"Остави ме на миру. Ostavi me na miru.","text_romanized":"OHS-tah-vee_meh nah_MEE-roo","text_english":"Please leave me alone.","source_caption":"Leave me alone.","register":"neutral","direction":"say","why":"Said firmly and quietly. Raising the volume is what turns it from a boundary into an incident in several of these cultures.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0034","lang":"srp","tier":1,"slot":"help.lost","domain":10,"text_native":"Изгубио сам се (m). Изгубила сам се (f). Izgubio sam se (m). Izgubila sam se (f).","text_romanized":"eez-GOO-byoh sahm seh/eez-GOO-bee-lah sahm seh","text_english":"I am lost.","source_caption":"I'm lost.","register":"neutral","direction":"say","why":"Asking a passer-by for help is a separate skill from reading a sign, and it uses different vocabulary in every one of these languages.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0035","lang":"srp","tier":1,"slot":"help.phone","domain":10,"text_native":"Могу ли да телефонирам? Mogu li da telefoniram?","text_romanized":"MOH-goo lee dah teh-leh-FOH-nee-rahm","text_english":"Can I use your phone?","source_caption":"Can I use your phone?","register":"neutral","direction":"say","why":"The most common thing a traveller needs that a phone provides, and asking a stranger for it is usually granted.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0036","lang":"srp","tier":1,"slot":"help.police","domain":10,"text_native":"Зваћу полицију. Zvaću policiju.","text_romanized":"ZVAH-tchoo poh-LEE-tseeyoo","text_english":"Please call the police.","source_caption":"I'll call the police.","register":"neutral","direction":"say","why":"Usually needs a phone, and in most places a local number rather than an international one.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"srp-t1-0037","lang":"srp","tier":1,"slot":"help.thief","domain":10,"text_native":"Лопов!, Lopov!","text_romanized":"LOH-pohf","text_english":"Stop, thief!","source_caption":"Thief!","register":"neutral","direction":"say","why":"Loud, and aimed at a crowd rather than at one person. Included because the vocabulary exists and because it is the sentence that makes people nearby move.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Serbian phrasebook","url":"https://en.wikivoyage.org/wiki/Serbian_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
