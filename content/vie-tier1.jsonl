{"id":"vie-t1-0001","lang":"vie","tier":1,"slot":"count.eight","domain":2,"text_native":"tám","text_romanized":null,"text_english":"Eight.","source_caption":"8","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0002","lang":"vie","tier":1,"slot":"count.five","domain":2,"text_native":"năm (\"nahm\")","text_romanized":null,"text_english":"Five.","source_caption":"5","register":"neutral","direction":"say","why":"Five is where most of these languages change to a different counting pattern, and knowing that in advance is the point of learning them in order.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0003","lang":"vie","tier":1,"slot":"count.four","domain":2,"text_native":"bốn (\"bone\")","text_romanized":null,"text_english":"Four.","source_caption":"4","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0004","lang":"vie","tier":1,"slot":"count.nine","domain":2,"text_native":"chín (\"chean\")","text_romanized":null,"text_english":"Nine.","source_caption":"9","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0005","lang":"vie","tier":1,"slot":"count.one","domain":2,"text_native":"một","text_romanized":null,"text_english":"One.","source_caption":"1","register":"neutral","direction":"say","why":"Counting from one upward in order, because a traveller counts by reciting rather than by arithmetic.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0006","lang":"vie","tier":1,"slot":"count.seven","domain":2,"text_native":"bảy","text_romanized":null,"text_english":"Seven.","source_caption":"7","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0007","lang":"vie","tier":1,"slot":"count.six","domain":2,"text_native":"sáu","text_romanized":null,"text_english":"Six.","source_caption":"6","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0008","lang":"vie","tier":1,"slot":"count.ten","domain":2,"text_native":"mười","text_romanized":null,"text_english":"Ten.","source_caption":"10","register":"neutral","direction":"say","why":"The first number past the counting pattern in most of these languages.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0009","lang":"vie","tier":1,"slot":"count.three","domain":2,"text_native":"ba","text_romanized":null,"text_english":"Three.","source_caption":"3","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0010","lang":"vie","tier":1,"slot":"count.two","domain":2,"text_native":"hai (\"high\")","text_romanized":null,"text_english":"Two.","source_caption":"2","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0011","lang":"vie","tier":1,"slot":"count.zero","domain":2,"text_native":"không","text_romanized":null,"text_english":"None, zero.","source_caption":"0","register":"neutral","direction":"say","why":"Zero is the answer that gets misheard most often, because the word for nothing and the word for a small quantity are often unrelated.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0012","lang":"vie","tier":1,"slot":"price.bill","domain":3,"text_native":"Thanh toán tiền giúp tôi.","text_romanized":null,"text_english":"The bill, please.","source_caption":"The check, please.","register":"neutral","direction":"say","why":"Where the word for bill and the word for receipt are the same word and neither is 'account'.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0013","lang":"vie","tier":1,"slot":"price.card-ok","domain":3,"text_native":"Có chấp nhận thẻ tín dụng không?","text_romanized":null,"text_english":"Is card payment accepted?","source_caption":"Do you accept credit cards?","register":"neutral","direction":"say","why":"The alternative to carrying cash, and the question that decides whether you are standing in a queue that moves.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0014","lang":"vie","tier":1,"slot":"price.too-cheap","domain":3,"text_native":"rẻ","text_romanized":null,"text_english":"It is cheaper in my country.","source_caption":"cheap","register":"neutral","direction":"say","why":"Read as an accusation almost everywhere. Included because knowing that it is an accusation is worth more than being able to say it politely.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0015","lang":"vie","tier":1,"slot":"price.too-expensive","domain":3,"text_native":"Đắt quá.","text_romanized":null,"text_english":"That is too expensive.","source_caption":"That's too expensive.","register":"neutral","direction":"say","why":"Used with the hand gesture that accompanies it. The gesture carries the meaning and the word confirms it.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0016","lang":"vie","tier":1,"slot":"money.atm","domain":3,"text_native":"Máy rút tiền (ATM) ở đâu?","text_romanized":null,"text_english":"Where is an ATM?","source_caption":"Where is an automatic teller machine (ATM)?","register":"neutral","direction":"understand","why":"Recognising rather than producing it: you will be shown the sign rather than expected to ask.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0017","lang":"vie","tier":1,"slot":"money.change","domain":3,"text_native":"Bạn đổi tiền cho tôi được không?","text_romanized":null,"text_english":"Please change this into local money.","source_caption":"Can you change money for me?","register":"neutral","direction":"say","why":"The word 'change' means both coins and alteration in several of these languages, and the wrong one is confusing.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0018","lang":"vie","tier":1,"slot":"money.exchange-rate","domain":3,"text_native":"Tỷ giá là bao nhiêu?","text_romanized":null,"text_english":"What is the exchange rate?","source_caption":"What is the exchange rate?","register":"neutral","direction":"understand","why":"Often answered by pointing at a board rather than spoken.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0019","lang":"vie","tier":1,"slot":"money.keep-change","domain":3,"text_native":"Anh hãy giữ lại tiền lẻ.","text_romanized":null,"text_english":"Please keep the change.","source_caption":"Keep the change!","register":"neutral","direction":"say","why":"Refusing loose coins is often faster and always understood.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"attested","id":"Tatoeba vie-en sentence pairs (CC BY 2.0 FR)","url":"https://tatoeba.org/en/downloads","licence":"CC BY 2.0 FR, some CC0","external_id":"558941","author":"CK"},"failure_flags":[]}
{"id":"vie-t1-0020","lang":"vie","tier":1,"slot":"toilet.where","domain":12,"text_native":"Toilet or WC or Nhà vệ sinh (nyah-vei-shing)","text_romanized":null,"text_english":"Where is the toilet?","source_caption":"TOILET","register":"neutral","direction":"say","why":"The most urgent question in this tier and the one every phrasebook leads with. In several languages the word is the only one a traveller needs for years.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0021","lang":"vie","tier":1,"slot":"food.bill-restaurant","domain":4,"text_native":"Làm ơn tính tiền.","text_romanized":null,"text_english":"Can we have the bill here, please?","source_caption":"The bill, please.","register":"neutral","direction":"say","why":"Sometimes distinct from the shop bill in the same language, and using the wrong one reads as asking to pay before finishing.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"attested","id":"Tatoeba vie-en sentence pairs (CC BY 2.0 FR)","url":"https://tatoeba.org/en/downloads","licence":"CC BY 2.0 FR, some CC0","external_id":"510362","author":"lukaszpp"},"failure_flags":[]}
{"id":"vie-t1-0022","lang":"vie","tier":1,"slot":"food.menu","domain":4,"text_native":"Làm ơn cho tôi xem menu?","text_romanized":null,"text_english":"The menu, please.","source_caption":"Can I look at the menu, please?","register":"neutral","direction":"say","why":"One question covers a whole meal. Most phrasebooks waste slots on individual dishes instead.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0023","lang":"vie","tier":1,"slot":"food.no-meat","domain":4,"text_native":"Tôi không ăn thịt lợn.","text_romanized":null,"text_english":"I do not eat meat.","source_caption":"I don't eat pork.","register":"neutral","direction":"say","why":"Saying it once at the start of the trip saves a refusal at the table, where it is awkward for both sides.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0024","lang":"vie","tier":1,"slot":"food.water","domain":4,"text_native":"nước","text_romanized":null,"text_english":"Water, please.","source_caption":"water","register":"neutral","direction":"say","why":"Refusing the water in a restaurant is a small discourtesy in several of these countries. This is how to ask for some instead.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0025","lang":"vie","tier":1,"slot":"way.straight","domain":7,"text_native":"đi thẳng","text_romanized":null,"text_english":"Go straight ahead.","source_caption":"straight ahead","register":"neutral","direction":"understand","why":"Recognised rather than produced.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0026","lang":"vie","tier":1,"slot":"way.turn-left","domain":7,"text_native":"Rẽ trái.","text_romanized":null,"text_english":"Turn left.","source_caption":"Turn left.","register":"neutral","direction":"understand","why":"Recognised rather than produced: you are the one being given directions far more often than giving them.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0027","lang":"vie","tier":1,"slot":"way.turn-right","domain":7,"text_native":"Rẽ phải.","text_romanized":null,"text_english":"Turn right.","source_caption":"Turn right.","register":"neutral","direction":"understand","why":"Recognised rather than produced.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0028","lang":"vie","tier":1,"slot":"stay.checkout","domain":5,"text_native":"Tôi muốn check out.","text_romanized":null,"text_english":"I would like to check out, please.","source_caption":"I want to check out.","register":"neutral","direction":"say","why":"Said the morning before leaving, so the bill is not waiting at the desk while luggage is being gathered.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0029","lang":"vie","tier":1,"slot":"move.destination","domain":6,"text_native":"Vui lòng đưa tôi đến đó.","text_romanized":null,"text_english":"Please take me there.","source_caption":"Take me there, please.","register":"neutral","direction":"say","why":"Shown with a map or a written address while saying it. 'There' is the word the pages use; 'this address' is in none of them, and a slot phrased from imagination rather than from a caption is a slot that can never be filled.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0030","lang":"vie","tier":1,"slot":"health.doctor","domain":9,"text_native":"Tôi cần một bác sĩ.","text_romanized":null,"text_english":"I need a doctor.","source_caption":"I need a doctor.","register":"neutral","direction":"say","why":"Short enough to say to anyone, which is the point — a phrase you cannot finish is a phrase that arrives too late.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0031","lang":"vie","tier":1,"slot":"health.hurt","domain":9,"text_native":"Tôi bị thương.","text_romanized":null,"text_english":"I have been injured.","source_caption":"I've been injured.","register":"neutral","direction":"say","why":"Declares the situation before being asked. Several of these languages change tense or register on the word for injury, and the flat version sounds like a complaint.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0032","lang":"vie","tier":1,"slot":"help.dont-touch","domain":10,"text_native":"Đừng chạm vào tôi!","text_romanized":null,"text_english":"Do not touch me.","source_caption":"Don't touch me!","register":"neutral","direction":"say","why":"Out loud and to a person, not shouted generally. Several of these languages treat it as an accusation, so it is a sentence to use deliberately.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0033","lang":"vie","tier":1,"slot":"help.emergency","domain":10,"text_native":"Việc này khẩn cấp.","text_romanized":null,"text_english":"It is an emergency.","source_caption":"It's an emergency.","register":"neutral","direction":"say","why":"Changes how the next thirty seconds go. Two words, and in several of these languages it reaches a different set of responses than a request would.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0034","lang":"vie","tier":1,"slot":"help.leave-me-alone","domain":10,"text_native":"Đừng làm phiền tôi.","text_romanized":null,"text_english":"Please leave me alone.","source_caption":"Leave me alone.","register":"neutral","direction":"say","why":"Said firmly and quietly. Raising the volume is what turns it from a boundary into an incident in several of these cultures.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0035","lang":"vie","tier":1,"slot":"help.lost","domain":10,"text_native":"Tôi bị lạc.","text_romanized":null,"text_english":"I am lost.","source_caption":"I'm lost.","register":"neutral","direction":"say","why":"Asking a passer-by for help is a separate skill from reading a sign, and it uses different vocabulary in every one of these languages.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0036","lang":"vie","tier":1,"slot":"help.phone","domain":10,"text_native":"Tôi dùng điện thoại của (second person pronoun) được không?","text_romanized":null,"text_english":"Can I use your phone?","source_caption":"Can I use your phone?","register":"neutral","direction":"say","why":"The most common thing a traveller needs that a phone provides, and asking a stranger for it is usually granted.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0037","lang":"vie","tier":1,"slot":"help.police","domain":10,"text_native":"Tôi sẽ gọi cảnh sát./Tôi sẽ gọi công an.","text_romanized":null,"text_english":"Please call the police.","source_caption":"I'll call the police.","register":"neutral","direction":"say","why":"Usually needs a phone, and in most places a local number rather than an international one.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"vie-t1-0038","lang":"vie","tier":1,"slot":"help.thief","domain":10,"text_native":"Ngừng lại! Ăn trộm!","text_romanized":null,"text_english":"Stop, thief!","source_caption":"Stop! Thief!","register":"neutral","direction":"say","why":"Loud, and aimed at a crowd rather than at one person. Included because the vocabulary exists and because it is the sentence that makes people nearby move.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Vietnamese phrasebook","url":"https://en.wikivoyage.org/wiki/Vietnamese_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
