{"id":"kor-t1-0004","lang":"kor","tier":1,"slot":"count.nine","domain":2,"text_native":"구","text_romanized":"gu","text_english":"Nine.","source_caption":"9","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Korean phrasebook","url":"https://en.wikivoyage.org/wiki/Korean_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"kor-t1-0005","lang":"kor","tier":1,"slot":"count.one","domain":2,"text_native":"일","text_romanized":"il","text_english":"One.","source_caption":"1","register":"neutral","direction":"say","why":"Counting from one upward in order, because a traveller counts by reciting rather than by arithmetic.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Korean phrasebook","url":"https://en.wikivoyage.org/wiki/Korean_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"kor-t1-0006","lang":"kor","tier":1,"slot":"count.seven","domain":2,"text_native":"칠","text_romanized":"chil","text_english":"Seven.","source_caption":"7","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Korean phrasebook","url":"https://en.wikivoyage.org/wiki/Korean_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
