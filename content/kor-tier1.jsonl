{"id":"kor-t1-0001","lang":"kor","tier":1,"slot":"count.eight","domain":2,"text_native":"팔","text_romanized":"pal","text_english":"Eight.","source_caption":"8","register":"neutral","direction":"say","why":"Continuing the count.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Korean phrasebook","url":"https://en.wikivoyage.org/wiki/Korean_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
{"id":"kor-t1-0002","lang":"kor","tier":1,"slot":"count.five","domain":2,"text_native":"오","text_romanized":"o","text_english":"Five.","source_caption":"5","register":"neutral","direction":"say","why":"Five is where most of these languages change to a different counting pattern, and knowing that in advance is the point of learning them in order.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Korean phrasebook","url":"https://en.wikivoyage.org/wiki/Korean_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
