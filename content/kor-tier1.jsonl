{"id":"kor-t1-0008","lang":"kor","tier":1,"slot":"count.ten","domain":2,"text_native":"십","text_romanized":"sip","text_english":"Ten.","source_caption":"10","register":"neutral","direction":"say","why":"The first number past the counting pattern in most of these languages.","exchange_id":null,"exchange_turn":null,"caution":null,"source":{"class":"curated","id":"Wikivoyage: Korean phrasebook","url":"https://en.wikivoyage.org/wiki/Korean_phrasebook","licence":"CC BY-SA 4.0","external_id":null,"author":null},"failure_flags":[]}
