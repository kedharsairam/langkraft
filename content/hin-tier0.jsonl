{"id": "hin-t0-0001", "lang": "hin", "tier": 0, "domain": 1, "text_native": "मना है (muh-nuh hay)}}", "text_romanized": "muh-nuh hay", "text_english": "FORBIDDEN", "register": "neutral", "direction": "understand", "why": "Signs on doors and shopfronts. You read these rather than say them, and misreading one puts you on the wrong side of a door.", "caution": null, "source": {"class": "curated", "id": "Wikivoyage: Hindi phrasebook", "url": "https://en.wikivoyage.org/wiki/Hindi%20phrasebook", "licence": "CC BY-SA 4.0", "external_id": null, "author": null, "corroborating_sentences": [], "contributor_share": null}, "failure_flags": []}
{"id": "hin-t0-0008", "lang": "hin", "tier": 0, "domain": 4, "text_native": "एक/दो लोग/-ओं के लिये जगह चाहिये — ek/do log/", "text_romanized": "on ke liye jagah cāhiye", "text_english": "A table for one person/two people, (please)", "register": "neutral", "direction": "say", "why": "Ordering, saying what you cannot eat, and understanding what arrives.", "caution": "Saying you cannot eat something is more reliably understood than describing what you can eat. Use the negative form.", "source": {"class": "curated", "id": "Wikivoyage: Hindi phrasebook", "url": "https://en.wikivoyage.org/wiki/Hindi%20phrasebook", "licence": "CC BY-SA 4.0", "external_id": null, "author": null, "corroborating_sentences": [], "contributor_share": null}, "failure_flags": []}
