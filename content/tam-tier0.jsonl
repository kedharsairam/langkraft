{"id":"tam-t0-0001","lang":"tam","tier":0,"domain":1,"text_native":"வணக்கம்","text_romanized":"vuh-nnuhk-kuhm","text_english":"Hello","register":"neutral","direction":"understand","why":"Signs on doors and shopfronts. You read these rather than say them, and misreading one puts you on the wrong side of a door.","caution":null,"source":{"class":"curated","id":"Wikivoyage: Tamil phrasebook","url":"https://en.wikivoyage.org/wiki/Tamil%20phrasebook","licence":"CC BY-SA 4.0","external_id":"11036634","author":"LanguageExpert","corroborating_sentences":[11036634],"contributor_share":null},"failure_flags":[]}
