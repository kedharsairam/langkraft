{"id": "kor-t0-0034", "lang": "kor", "tier": 0, "domain": 6, "text_native": "이 기차/버스는 어디로 갑니까?", "text_romanized": "i gicha/beoseu-neun eodiro gamnikka?", "text_english": "Where does this train/bus go?", "register": "neutral", "direction": "say", "why": "Getting somewhere you have not been before, which is most of what travel is.", "caution": "Directions assume you can hear the name of a place afterwards. Ask for it to be repeated, or written down.", "source": {"class": "curated", "id": "Wikivoyage: Korean phrasebook", "url": "https://en.wikivoyage.org/wiki/Korean%20phrasebook", "licence": "CC BY-SA 4.0", "external_id": null, "author": null, "corroborating_sentences": [], "contributor_share": null}, "failure_flags": []}
