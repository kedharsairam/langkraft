<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No AppCompat dependency. The activity theme only has to supply a window
      background and no action bar; everything visual is Compose.
    -->
    <style name="Theme.LangKraft" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kraft_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
