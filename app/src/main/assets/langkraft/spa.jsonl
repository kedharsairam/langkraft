{"id":"spa-001","lang":"spa","theme":1,"english":"Hello.","romanization":"Hola","youSay":"OH-lah","soundTip":"H is silent.","note":"Polite and neutral.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-002","lang":"spa","theme":1,"english":"Good morning.","romanization":"Buenos dias","youSay":"BWEH-nos DEE-ahs","soundTip":"Stress BWEH and DEE. Vowels pure like Telugu.","note":"Use until midday.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-003","lang":"spa","theme":1,"english":"Good afternoon.","romanization":"Buenas tardes","youSay":"BWEH-nas TAR-des","soundTip":"TAR-des = afternoon. S is soft.","note":"Same as evening in many places.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-004","lang":"spa","theme":1,"english":"Good evening / Good night.","romanization":"Buenas noches","youSay":"BWEH-nas NOH-ches","soundTip":"NOH-ches = night. CH as in cheese.","note":"Arriving after sunset.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-005","lang":"spa","theme":1,"english":"Goodbye.","romanization":"Adios","youSay":"ah-DYOS","soundTip":"DY = y in yes.","note":"Hasta luego is softer for leave-taking.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-006","lang":"spa","theme":2,"english":"Please.","romanization":"Por favor","youSay":"por fah-VOR","soundTip":"VOR uses B sound. No /v/.","note":"Use everywhere.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-007","lang":"spa","theme":2,"english":"Thank you.","romanization":"Gracias","youSay":"GRAH-syahs","soundTip":"GRAS with hard G, ends -syahs.","note":"Muchas gracias = thank you very much.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-008","lang":"spa","theme":2,"english":"You are welcome.","romanization":"De nada","youSay":"deh NAH-dah","soundTip":"NAH-dah = of nothing.","note":"Short polite reply.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-009","lang":"spa","theme":2,"english":"Excuse me.","romanization":"Disculpe","youSay":"dees-KOOL-peh","soundTip":"Polite usted form. KOOL with long O.","note":"Better than perdon for strangers.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-010","lang":"spa","theme":2,"english":"I'm sorry.","romanization":"Lo siento","youSay":"lo SYEN-toh","soundTip":"SYEN = soft T, do not bite.","note":"For apologies.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-011","lang":"spa","theme":3,"english":"How much is this?","romanization":"Cuanto cuesta esto?","youSay":"KWAN-toh KWES-tah ES-toh","soundTip":"KWES = soft ST, ES-toh = this.","note":"Price check.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-012","lang":"spa","theme":3,"english":"Too expensive.","romanization":"Muy caro","youSay":"mooee KAH-roh","soundTip":"mooee = muy, KAH-roh = expensive.","note":"Bargaining cue.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-013","lang":"spa","theme":3,"english":"Can I pay by card?","romanization":"Puedo pagar con tarjeta?","youSay":"PWEH-doh pah-GAR kon tar-HEH-tah","soundTip":"PWEH with W glide, HEH with soft H.","note":"Tarjeta = card.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-014","lang":"spa","theme":3,"english":"The bill, please.","romanization":"La cuenta, por favor","youSay":"lah KWEN-tah por fah-VOR","soundTip":"KWEN = similar to cuesta.","note":"At restaurant.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-015","lang":"spa","theme":3,"english":"A cheaper one?","romanization":"Uno mas barato?","youSay":"OO-noh mas bah-RAH-toh","soundTip":"bah-RAH with soft B.","note":"Mas = more.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-016","lang":"spa","theme":4,"english":"I would like this.","romanization":"Quisiera esto","youSay":"kee-SYEH-rah ES-toh","soundTip":"Polite conditional. SYEH soft.","note":"Pointing also works.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-017","lang":"spa","theme":4,"english":"Water, please.","romanization":"Agua, por favor","youSay":"AH-gwah por fah-VOR","soundTip":"AH-gwah with GW glide.","note":"Ask embotellada if you want bottled.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-018","lang":"spa","theme":4,"english":"Not spicy.","romanization":"No picante","youSay":"noh pee-KAN-teh","soundTip":"KAN = sharp, not nasal.","note":"Picante = spicy.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-019","lang":"spa","theme":4,"english":"This is delicious.","romanization":"Esta muy rico","youSay":"ES-tah mooee REE-koh","soundTip":"REE-koh with rolled R.","note":"Rico = tasty.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-020","lang":"spa","theme":4,"english":"A table for two.","romanization":"Una mesa para dos","youSay":"OO-nah MEH-sah PAH-rah dos","soundTip":"MEH-sah = table.","note":"At restaurant.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-021","lang":"spa","theme":5,"english":"Where is the bathroom?","romanization":"Donde esta el bano?","youSay":"DON-deh ES-tah el BAH-nyoh","soundTip":"BAH-nyoh = ny like canyon.","note":"Bano in Latin America.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-022","lang":"spa","theme":5,"english":"Where is the station?","romanization":"Donde esta la estacion?","youSay":"DON-deh ES-tah lah es-tah-SYON","soundTip":"SYON = SHON.","note":"Station.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-023","lang":"spa","theme":5,"english":"How far is it?","romanization":"Esta lejos?","youSay":"ES-tah LEH-hos","soundTip":"LEH-hos = far, H silent.","note":"Cerca = near.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-024","lang":"spa","theme":5,"english":"Left, right, straight.","romanization":"Izquierda, derecha, recto","youSay":"ees-KYER-dah deh-REH-chah REK-toh","soundTip":"REH-chah = right, REK-toh = straight.","note":"Izquierda left.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-025","lang":"spa","theme":5,"english":"Stop here, please.","romanization":"Pare aqui, por favor","youSay":"PAH-reh ah-KEE por fah-VOR","soundTip":"PAH = stop.","note":"For taxi.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-026","lang":"spa","theme":6,"english":"How much for two?","romanization":"Cuanto es para dos?","youSay":"KWAN-toh es PAH-rah dos","soundTip":"Same price pattern.","note":"Shopping.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-027","lang":"spa","theme":6,"english":"Just looking.","romanization":"Solo mirando","youSay":"SOH-loh mee-RAN-doh","soundTip":"mee-RAN = looking.","note":"Polite decline.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-028","lang":"spa","theme":6,"english":"A bigger one?","romanization":"Uno mas grande?","youSay":"OO-noh mas GRAN-deh","soundTip":"GRAN = big.","note":"Grande = large.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-029","lang":"spa","theme":6,"english":"Say it again slowly.","romanization":"Digalo despacio, por favor","youSay":"DEE-gah-loh des-PAH-syoh por fah-VOR","soundTip":"des-PAH = slow.","note":"Glue phrase 1.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-030","lang":"spa","theme":6,"english":"I will take it.","romanization":"Lo llevo","youSay":"lo LYEH-voh","soundTip":"LYEH = y in yes, voh = B sound.","note":"At shop.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-031","lang":"spa","theme":7,"english":"Help!","romanization":"Ayuda!","youSay":"ah-YOO-dah","soundTip":"Short shout.","note":"Urgent.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-032","lang":"spa","theme":7,"english":"I need a doctor.","romanization":"Necesito un medico","youSay":"neh-seh-SEE-toh un MEH-dee-koh","soundTip":"SEE = strong.","note":"Medico = doctor.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-033","lang":"spa","theme":7,"english":"I'm lost.","romanization":"Estoy perdido","youSay":"ES-toy per-DEE-doh","soundTip":"per-DEE = lost.","note":"Perdida if female speaker — use perdido as default.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-034","lang":"spa","theme":7,"english":"Where is the pharmacy?","romanization":"Donde esta la farmacia?","youSay":"DON-deh ES-tah lah far-MAH-syah","soundTip":"far-MAH = stress on MAH.","note":"Farmacia = pharmacy.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-035","lang":"spa","theme":7,"english":"Call the police.","romanization":"Llame a la policia","youSay":"YAH-meh ah lah poh-lee-SEE-ah","soundTip":"YAH = polite imperative.","note":"Say with urgency.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-036","lang":"spa","theme":8,"english":"My name is ...","romanization":"Me llamo ...","youSay":"meh YAH-moh","soundTip":"YAH = ya.","note":"Introduce yourself.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-037","lang":"spa","theme":8,"english":"I'm from India.","romanization":"Soy de India","youSay":"soy deh IN-dyah","soundTip":"IN = India.","note":"Simple intro.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-038","lang":"spa","theme":8,"english":"I don't speak Spanish well.","romanization":"No hablo bien espanol","youSay":"noh AH-blah byen es-pah-NYOL","soundTip":"AH-blah = speak.","note":"Espanol = Spanish.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-039","lang":"spa","theme":8,"english":"Do you speak English?","romanization":"Habla usted ingles?","youSay":"AH-blah oos-TED in-GLES","soundTip":"English borrow.","note":"Safety net.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-040","lang":"spa","theme":8,"english":"Nice to meet you.","romanization":"Mucho gusto","youSay":"MOO-choh GUS-toh","soundTip":"GUS = gusto.","note":"Warm goodbye.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-glue1","lang":"spa","theme":8,"english":"What does ... mean?","romanization":"Que significa ...?","youSay":"keh seeg-nee-FEE-kah","soundTip":"sig = sign.","note":"Glue phrase 2.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
{"id":"spa-glue2","lang":"spa","theme":8,"english":"How do you say ... ?","romanization":"Como se dice ... ?","youSay":"KOH-moh seh DEE-seh","soundTip":"KOH = how.","note":"Glue phrase 3.","source":"Wikivoyage: Spanish phrasebook (CC BY-SA 4.0)","checked":"2026-11-06"}
